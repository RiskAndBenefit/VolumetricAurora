/**
 * AuroraControlPoint.ush
 * Flow field control point implementations
 * Provides various flow primitives: gravity, vortex, spiral, curl, etc.
 */

#pragma once

#include "/VolumetricAuroraShaders/Private/AuroraNoise.ush"

/**
 * Compute influence weight based on distance attenuation
 * Provides smooth falloff from full influence to zero at the boundary
 *
 * @param Distance Current distance from the control point center
 * @param AttenuationStart Distance at which attenuation begins (full influence inside)
 * @param AttenuationEnd Distance at which influence reaches zero
 * @param AttenuationExponent Falloff curve exponent (higher = sharper cutoff near edge)
 * @param IsGlobal If true, returns 1.0 regardless of distance (infinite influence)
 * @return Weight value in [0, 1] range
 */
float ComputeInfluenceWeight(
	float Distance,
	float AttenuationStart,
	float AttenuationEnd,
	float AttenuationExponent,
	bool IsGlobal
)
{
	if (IsGlobal) return 1.f;
	
	float w = 1.f;

	if (AttenuationEnd > AttenuationStart)
	{
		// Normalize distance into [0, 1] attenuation interval
		float t = saturate(
			(AttenuationEnd - Distance) /
			max(AttenuationEnd - AttenuationStart, 1e-4f)
		);

		// Optional smoothing of the edge
		w = smoothstep(0.f, 1.f, t);

		// Shape falloff curve (higher exponent = sharper cutoff near edge)
		w = pow(w, max(AttenuationExponent, 1.f));
	}

	return w;
}


/**
 * Compute radial gravity/source velocity field
 * Formula: v = (m / 2πr) * r̂
 * Positive strength = source (outward flow)
 * Negative strength = sink (inward flow)
 *
 * @param CurrentPosition UV position to calculate velocity at
 * @param SourcePosition Control point center position
 * @param RadialStrength Radial force magnitude (positive=divergence, negative=convergence)
 * @param AttenuationStart Distance at which attenuation begins (full influence inside)
 * @param AttenuationEnd Distance at which influence reaches zero
 * @param AttenuationExponent Falloff curve exponent (higher = sharper cutoff near edge)
 * @param IsGlobal If true, influence is not attenuated by distance
 * @return Velocity vector at current position
 */
float2 ComputeGravity(
	float2 CurrentPosition,
	float2 SourcePosition,
	float RadialStrength,
	float AttenuationStart,
	float AttenuationEnd,
	float AttenuationExponent,
	bool IsGlobal
)
{
	// Vector from source to current position (flow direction for divergence)
	float2 ToCurrentPosition = CurrentPosition - SourcePosition;

	// Distance calculation with epsilon to prevent division by zero
	float Distance = length(ToCurrentPosition);
	float SafeDistance = max(Distance, 0.01f);

	// Normalized radial direction
	float2 RadialDirection = ToCurrentPosition / SafeDistance;

	// Velocity magnitude: m / (2πr)
	// Division by circumference preserves total flux
	// Closer to source = faster velocity
	float VelocityMagnitude = RadialStrength / (2.0 * PI * SafeDistance);

	// Smooth fade toward the boundary, then sharpen with exponent
	float w = ComputeInfluenceWeight(
		Distance,
		AttenuationStart,
		AttenuationEnd,
		AttenuationExponent,
		IsGlobal
	);
	
	// Final velocity vector = direction × magnitude
	float2 Velocity = RadialDirection * VelocityMagnitude * w;

	return Velocity;
}

/**
 * Compute vortex (rotational) velocity field
 * Formula: v = (Γ / 2πr) * θ̂
 * Creates circular flow around a center point
 *
 * @param CurrentPosition UV position to calculate velocity at
 * @param VortexPosition Control point center position
 * @param RotationStrength Rotational strength (positive=CCW, negative=CW)
 * @param AttenuationStart Distance at which attenuation begins (full influence inside)
 * @param AttenuationEnd Distance at which influence reaches zero
 * @param AttenuationExponent Falloff curve exponent (higher = sharper cutoff near edge)
 * @param IsGlobal If true, influence is not attenuated by distance
 * @return Tangential velocity vector at current position
 */
float2 ComputeVortex(
	float2 CurrentPosition,
	float2 VortexPosition,
	float RotationStrength,
	float AttenuationStart,
	float AttenuationEnd,
	float AttenuationExponent,
	bool IsGlobal
)
{
	// Vector from vortex center to current position
	float2 RadialVector = CurrentPosition - VortexPosition;

	// Distance calculation
	float Distance = length(RadialVector);
	float SafeDistance = max(Distance, 0.01f);

	// Tangent direction (perpendicular to radial)
	// 2D rotation by 90°: (x, y) -> (-y, x) = counter-clockwise
	float2 TangentDirection = float2(-RadialVector.y, RadialVector.x) / SafeDistance;

	// Velocity magnitude: Γ / 2πr
	float VelocityMagnitude = RotationStrength / (2.0 * PI * SafeDistance);

	float w = ComputeInfluenceWeight(
		Distance,
		AttenuationStart,
		AttenuationEnd,
		AttenuationExponent,
		IsGlobal
	);
	
	// Final velocity
	float2 Velocity = TangentDirection * VelocityMagnitude * w;

	return Velocity;
}

/**
 * Compute spiral velocity field (sink + vortex combination)
 * Linear superposition of inward flow and rotation
 * Creates spiral patterns converging to center
 *
 * @param CurrentPosition UV position to calculate velocity at
 * @param SpiralPosition Control point center position
 * @param RadialStrength Inward pull strength
 * @param RadialAttenuationStart Distance at which radial attenuation begins
 * @param RadialAttenuationEnd Distance at which radial influence reaches zero
 * @param RadialAttenuationExponent Radial falloff curve exponent
 * @param RotationStrength Rotational strength
 * @param RotationAttenuationStart Distance at which rotation attenuation begins
 * @param RotationAttenuationEnd Distance at which rotation influence reaches zero
 * @param RotationAttenuationExponent Rotation falloff curve exponent
 * @param IsGlobal If true, influence is not attenuated by distance
 * @return Combined velocity vector (radial + tangential)
 */
float2 ComputeSpiral(
	float2 CurrentPosition,
	float2 SpiralPosition,
	float RadialStrength,
	float RadialAttenuationStart,
	float RadialAttenuationEnd,
	float RadialAttenuationExponent,
	float RotationStrength,
	float RotationAttenuationStart,
	float RotationAttenuationEnd,
	float RotationAttenuationExponent,
	bool IsGlobal
)
{
	// Linear superposition: Sink + Vortex
	float2 SinkFlow = ComputeGravity(
		CurrentPosition,
		SpiralPosition,
		-RadialStrength,
		RadialAttenuationStart,
		RadialAttenuationEnd,
		RadialAttenuationExponent,
		IsGlobal
	);
	float2 VortexFlow = ComputeVortex(
		CurrentPosition,
		SpiralPosition,
		RotationStrength,
		RotationAttenuationStart,
		RotationAttenuationEnd,
		RotationAttenuationExponent,
		IsGlobal
	);

	return SinkFlow + VortexFlow;
}

/**
 * Compute dipole velocity field
 * Combination of source and sink placed infinitesimally close
 * Creates directional flow around objects (like flow around cylinder)
 * Formula: v = (μ / 2πr²) * (cosθ r̂ + sinθ θ̂)
 *
 * @param CurrentPosition UV position to calculate velocity at
 * @param DipolePosition Dipole center position
 * @param DipoleDirection Normalized dipole axis direction
 * @param DipoleStrength Dipole moment magnitude
 * @param AttenuationStart Distance at which attenuation begins (full influence inside)
 * @param AttenuationEnd Distance at which influence reaches zero
 * @param AttenuationExponent Falloff curve exponent (higher = sharper cutoff near edge)
 * @param IsGlobal If true, influence is not attenuated by distance
 * @return Velocity vector with r^(-2) falloff
 */
float2 ComputeDipole(
	float2 CurrentPosition,
	float2 DipolePosition,
	float2 DipoleDirection,
	float DipoleStrength,
	float AttenuationStart,
	float AttenuationEnd,
	float AttenuationExponent,
	bool IsGlobal
)
{
	// Vector from dipole to current position
	float2 Offset = CurrentPosition - DipolePosition;

	// Distance calculation (dipole decays as r^2, faster than source/sink)
	float DistanceSquared = dot(Offset, Offset);
	float SafeDistanceSquared = max(DistanceSquared, 0.01f);
	float SafeDistance = sqrt(SafeDistanceSquared);

	DipoleDirection = normalize(DipoleDirection);

	// cos(θ): angle between dipole axis and position vector
	// Using dot product: cos θ = (dipoleDir · offset) / |offset|
	float CosTheta = dot(DipoleDirection, Offset) / SafeDistance;

	// sin(θ): using 2D cross product z-component
	// sin θ = (dipoleDir × offset)_z / |offset|
	float SinTheta = (
		DipoleDirection.x * Offset.y - DipoleDirection.y * Offset.x
	) / SafeDistance;

	// Radial unit vector
	float2 RadialDirection = Offset / SafeDistance;

	// Tangent unit vector (90° rotation of radial)
	float2 TangentDirection = float2(-RadialDirection.y, RadialDirection.x);

	// Velocity magnitude: μ / 2πr²
	float VelocityScale = DipoleStrength / (2.0 * PI * SafeDistanceSquared);

	// Final velocity: radial component + tangential component
	float2 Velocity = VelocityScale * (
		CosTheta * RadialDirection + SinTheta * TangentDirection
	);

	float w = ComputeInfluenceWeight(
		SafeDistance,
		AttenuationStart,
		AttenuationEnd,
		AttenuationExponent,
		IsGlobal
	);

	return Velocity * w;
}

