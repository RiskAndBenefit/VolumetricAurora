/**
 * AuroraNoise.ush
 * Comprehensive noise function library for procedural generation
 * Includes: Value, Gradient, Perlin, Simplex noise (2D/4D)
 * Features: FBM, Curl noise, Seamless tiling, Domain warping
 */

#pragma once

#include "/VolumetricAuroraShaders/Private/AuroraMath.ush"

/**
 * 4D gradient helper for Perlin4D noise
 * @param Hash Hash value for gradient selection
 * @param Offset 4D offset vector from grid point
 * @return Gradient dot product result
 */
float Grad4D(int Hash, float4 Offset)
{
	int H = Hash & 31;
	float A = Offset[H & 3];
	float B = Offset[(H >> 2) & 3];
	float C = Offset[(H >> 4) & 3];
	return ((H & 4) ? -A : A) + ((H & 8) ? -B : B) + ((H & 16) ? -C : C);
}

/**
 * 2D Value Noise
 * Interpolates random values at grid vertices
 * @param UV Input coordinates
 * @return Noise value in approximate range [-1, 1]
 */
float ValueNoise2D(float2 UV)
{
	float2 CellIndex = floor(UV);
	float2 LocalPosition = frac(UV);

	float BottomLeft = Hash(CellIndex);
	float BottomRight = Hash(CellIndex + float2(1.0, 0.0));
	float TopLeft = Hash(CellIndex + float2(0.0, 1.0));
	float TopRight = Hash(CellIndex + float2(1.0, 1.0));

	float2 Blend = smoothstep(0.0, 1.0, LocalPosition);

	return lerp(
		lerp(BottomLeft, BottomRight, Blend.x),
		lerp(TopLeft, TopRight, Blend.x),
		Blend.y
	);
}

/**
 * 2D Gradient Noise
 * Interpolates dot products of random gradients
 * @param UV Input coordinates
 * @return Noise value in approximate range [-1, 1]
 */
float GradientNoise2D(float2 UV)
{
	float2 CellIndex = floor(UV);
	float2 LocalPosition = frac(UV);

	float2 Blend = QuinticSmooth(LocalPosition);

	float BottomLeft = dot(Gradient(CellIndex), LocalPosition);
	float BottomRight = dot(
		Gradient(CellIndex + float2(1, 0)),
		LocalPosition - float2(1, 0)
	);
	float TopLeft = dot(
		Gradient(CellIndex + float2(0, 1)),
		LocalPosition - float2(0, 1)
	);
	float TopRight = dot(
		Gradient(CellIndex + float2(1, 1)),
		LocalPosition - float2(1, 1)
	);

	return lerp(
		lerp(BottomLeft, BottomRight, Blend.x),
		lerp(TopLeft, TopRight, Blend.x),
		Blend.y
	);
}

/**
 * 2D Perlin Noise (permutation table based)
 * Classic implementation using Ken Perlin's permutation table
 * @param UV Input coordinates
 * @return Noise value in approximate range [-1, 1]
 */
float PerlinNoise2D(float2 UV)
{
	static const int perm[512] = {
		151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,
		140,36,103,30,69,142,8,99,37,240,21,10,23,190,6,148,
		247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,
		57,177,33,88,237,149,56,87,174,20,125,136,171,168,68,175,
		74,165,71,134,139,48,27,166,77,146,158,231,83,111,229,122,
		60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,
		65,25,63,161,1,216,80,73,209,76,132,187,208,89,18,169,
		200,196,135,130,116,188,159,86,164,100,109,198,173,186,3,64,
		52,217,226,250,124,123,5,202,38,147,118,126,255,82,85,212,
		207,206,59,227,47,16,58,17,182,189,28,42,223,183,170,213,
		119,248,152,2,44,154,163,70,221,153,101,155,167,43,172,9,
		129,22,39,253,19,98,108,110,79,113,224,232,178,185,112,104,
		218,246,97,228,251,34,242,193,238,210,144,12,191,179,162,241,
		81,51,145,235,249,14,239,107,49,192,214,31,181,199,106,157,
		184,84,204,176,115,121,50,45,127,4,150,254,138,236,205,93,
		222,114,67,29,24,72,243,141,128,195,78,66,215,61,156,180,
		// Repeat (256-511)
		151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,
		140,36,103,30,69,142,8,99,37,240,21,10,23,190,6,148,
		247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,
		57,177,33,88,237,149,56,87,174,20,125,136,171,168,68,175,
		74,165,71,134,139,48,27,166,77,146,158,231,83,111,229,122,
		60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,
		65,25,63,161,1,216,80,73,209,76,132,187,208,89,18,169,
		200,196,135,130,116,188,159,86,164,100,109,198,173,186,3,64,
		52,217,226,250,124,123,5,202,38,147,118,126,255,82,85,212,
		207,206,59,227,47,16,58,17,182,189,28,42,223,183,170,213,
		119,248,152,2,44,154,163,70,221,153,101,155,167,43,172,9,
		129,22,39,253,19,98,108,110,79,113,224,232,178,185,112,104,
		218,246,97,228,251,34,242,193,238,210,144,12,191,179,162,241,
		81,51,145,235,249,14,239,107,49,192,214,31,181,199,106,157,
		184,84,204,176,115,121,50,45,127,4,150,254,138,236,205,93,
		222,114,67,29,24,72,243,141,128,195,78,66,215,61,156,180
	};

	int CellX = (int)floor(UV.x) & 255;
	int CellY = (int)floor(UV.y) & 255;

	float LocalX = UV.x - floor(UV.x);
	float LocalY = UV.y - floor(UV.y);

	float BlendX = QuinticSmooth(LocalX);
	float BlendY = QuinticSmooth(LocalY);

	int HashBL = perm[perm[CellX] + CellY];
	int HashTL = perm[perm[CellX] + CellY + 1];
	int HashBR = perm[perm[CellX + 1] + CellY];
	int HashTR = perm[perm[CellX + 1] + CellY + 1];

	float GradBL = HashGradient(HashBL, LocalX, LocalY);
	float GradBR = HashGradient(HashBR, LocalX - 1.0, LocalY);
	float GradTL = HashGradient(HashTL, LocalX, LocalY - 1.0);
	float GradTR = HashGradient(HashTR, LocalX - 1.0, LocalY - 1.0);

	float Bottom = lerp(GradBL, GradBR, BlendX);
	float Top = lerp(GradTL, GradTR, BlendX);

	return lerp(Bottom, Top, BlendY);
}

/**
 * 2D Simplex Noise
 * Ken Perlin's improved noise with better visual isotropy
 * Uses triangular grid instead of square grid
 *
 * @param Position Input coordinates
 * @param Seed Optional seed for variation
 * @return Noise value in approximate range [-1, 1]
 */
float SimplexNoise2D(float2 Position, float Seed = 0.f)
{
	const float SKEW_2D = 0.36602540378f;     // (sqrt(3) - 1) / 2
	const float UNSKEW_2D = 0.21132486540f;   // (3 - sqrt(3)) / 6

	// Skew input space to equilateral triangle grid
	float SkewOffset = (Position.x + Position.y) * SKEW_2D;
	float2 Skewed = Position + SkewOffset;
	float2 Cell = floor(Skewed);

	// Unskew back to regular space
	float UnskewOffset = (Cell.x + Cell.y) * UNSKEW_2D;
	float2 CellOrigin = Cell - UnskewOffset;
	float2 Offset0 = Position - CellOrigin;

	// Determine which triangle we're in
	float2 Offset1 = (Offset0.x > Offset0.y)
		? float2(1.0, 0.0)
		: float2(0.0, 1.0);

	// Distance vectors to three simplex corners
	float2 Offset1Pos = Offset0 - Offset1 + UNSKEW_2D;
	float2 Offset2Pos = Offset0 - 1.0 + 2.0 * UNSKEW_2D;

	// Gradients at three corners
	float2 Grad0 = Gradient(Cell, Seed);
	float2 Grad1 = Gradient(Cell + Offset1, Seed);
	float2 Grad2 = Gradient(Cell + 1.0, Seed);

	// Falloff calculation (t = 0.5 - r^2, clamp negative to 0)
	float3 Falloff = max(0.0, 0.5 - float3(
		dot(Offset0, Offset0),
		dot(Offset1Pos, Offset1Pos),
		dot(Offset2Pos, Offset2Pos)
	));

	// t^4 for smooth falloff
	float3 Falloff2 = Falloff * Falloff;
	float3 Falloff4 = Falloff2 * Falloff2;

	// Gradient dot products
	float3 GradDot = float3(
		dot(Grad0, Offset0),
		dot(Grad1, Offset1Pos),
		dot(Grad2, Offset2Pos)
	);

	// Sum and scale to approximate [-1, 1] range
	return 70.0 * dot(Falloff4, GradDot);
}

/**
 * 4D Simplex Noise
 * Used for seamless tiling via torus mapping
 *
 * @param Position 4D input coordinates
 * @param Seed Optional seed for variation
 * @return Noise value in approximate range [-1, 1]
 */
float SimplexNoise4D(float4 Position, float Seed = 0.f)
{
	// 4D Simplex constants
	const float F4 = 0.309016994374947;  // (sqrt(5) - 1) / 4
	const float G4 = 0.138196601125011;  // (5 - sqrt(5)) / 20

	// Skew input coordinates
	float SkewSum = (Position.x + Position.y + Position.z + Position.w) * F4;
	float4 Skewed = Position + SkewSum;
	float4 Cell = floor(Skewed);

	// Unskew to get cell origin
	float UnskewSum = (Cell.x + Cell.y + Cell.z + Cell.w) * G4;
	float4 CellOrigin = Cell - UnskewSum;
	float4 Offset0 = Position - CellOrigin;

	// Determine simplex ordering (5 vertices in 4D)
	// Rank components by magnitude
	int4 Order = int4(0, 0, 0, 0);
	if (Offset0.x > Offset0.y) Order.x++; else Order.y++;
	if (Offset0.x > Offset0.z) Order.x++; else Order.z++;
	if (Offset0.x > Offset0.w) Order.x++; else Order.w++;
	if (Offset0.y > Offset0.z) Order.y++; else Order.z++;
	if (Offset0.y > Offset0.w) Order.y++; else Order.w++;
	if (Offset0.z > Offset0.w) Order.z++; else Order.w++;

	// Convert ordering to simplex offsets
	int4 i1 = int4(
		Order.x >= 3,
		Order.y >= 3,
		Order.z >= 3,
		Order.w >= 3
	);
	int4 i2 = int4(
		Order.x >= 2,
		Order.y >= 2,
		Order.z >= 2,
		Order.w >= 2
	);
	int4 i3 = int4(
		Order.x >= 1,
		Order.y >= 1,
		Order.z >= 1,
		Order.w >= 1
	);

	// Distance vectors to 5 simplex corners
	float4 Offset1 = Offset0 - float4(i1) + G4;
	float4 Offset2 = Offset0 - float4(i2) + 2.0 * G4;
	float4 Offset3 = Offset0 - float4(i3) + 3.0 * G4;
	float4 Offset4 = Offset0 - 1.0 + 4.0 * G4;

	// Gradients at 5 corners
	float4 Grad0 = Gradient4D(Cell, Seed);
	float4 Grad1 = Gradient4D(Cell + float4(i1), Seed);
	float4 Grad2 = Gradient4D(Cell + float4(i2), Seed);
	float4 Grad3 = Gradient4D(Cell + float4(i3), Seed);
	float4 Grad4 = Gradient4D(Cell + 1.0, Seed);

	// Falloff calculation (t = 0.6 - r^2)
	float Falloff0 = max(0.0, 0.6 - dot(Offset0, Offset0));
	float Falloff1 = max(0.0, 0.6 - dot(Offset1, Offset1));
	float Falloff2 = max(0.0, 0.6 - dot(Offset2, Offset2));
	float Falloff3 = max(0.0, 0.6 - dot(Offset3, Offset3));
	float Falloff4 = max(0.0, 0.6 - dot(Offset4, Offset4));

	// t^4 for smooth falloff
	Falloff0 *= Falloff0; Falloff0 *= Falloff0;
	Falloff1 *= Falloff1; Falloff1 *= Falloff1;
	Falloff2 *= Falloff2; Falloff2 *= Falloff2;
	Falloff3 *= Falloff3; Falloff3 *= Falloff3;
	Falloff4 *= Falloff4; Falloff4 *= Falloff4;

	// Sum contributions
	float NoiseValue = Falloff0 * dot(Grad0, Offset0)
		+ Falloff1 * dot(Grad1, Offset1)
		+ Falloff2 * dot(Grad2, Offset2)
		+ Falloff3 * dot(Grad3, Offset3)
		+ Falloff4 * dot(Grad4, Offset4);

	// Scale to approximate [-1, 1] range
	return 27.0 * NoiseValue;
}

/**
 * 4D Value Noise
 * Used for seamless tiling
 * @param Position 4D input coordinates
 * @return Noise value in approximate range [0, 1]
 */
float ValueNoise4D(float4 Position)
{
	float4 CellIndex = floor(Position);
	float4 LocalPosition = frac(Position);
	float4 Blend = LocalPosition * LocalPosition * LocalPosition
		* (LocalPosition * (LocalPosition * 6.0 - 15.0) + 10.0);

	// 16 corner hash values (4D hypercube vertices)
	float n0000 = Hash(CellIndex);
	float n1000 = Hash(CellIndex + float4(1, 0, 0, 0));
	float n0100 = Hash(CellIndex + float4(0, 1, 0, 0));
	float n1100 = Hash(CellIndex + float4(1, 1, 0, 0));
	float n0010 = Hash(CellIndex + float4(0, 0, 1, 0));
	float n1010 = Hash(CellIndex + float4(1, 0, 1, 0));
	float n0110 = Hash(CellIndex + float4(0, 1, 1, 0));
	float n1110 = Hash(CellIndex + float4(1, 1, 1, 0));
	float n0001 = Hash(CellIndex + float4(0, 0, 0, 1));
	float n1001 = Hash(CellIndex + float4(1, 0, 0, 1));
	float n0101 = Hash(CellIndex + float4(0, 1, 0, 1));
	float n1101 = Hash(CellIndex + float4(1, 1, 0, 1));
	float n0011 = Hash(CellIndex + float4(0, 0, 1, 1));
	float n1011 = Hash(CellIndex + float4(1, 0, 1, 1));
	float n0111 = Hash(CellIndex + float4(0, 1, 1, 1));
	float n1111 = Hash(CellIndex + float4(1, 1, 1, 1));

	// 4D linear interpolation
	float nx000 = lerp(n0000, n1000, Blend.x);
	float nx100 = lerp(n0100, n1100, Blend.x);
	float nx010 = lerp(n0010, n1010, Blend.x);
	float nx110 = lerp(n0110, n1110, Blend.x);
	float nx001 = lerp(n0001, n1001, Blend.x);
	float nx101 = lerp(n0101, n1101, Blend.x);
	float nx011 = lerp(n0011, n1011, Blend.x);
	float nx111 = lerp(n0111, n1111, Blend.x);

	float nxy00 = lerp(nx000, nx100, Blend.y);
	float nxy10 = lerp(nx010, nx110, Blend.y);
	float nxy01 = lerp(nx001, nx101, Blend.y);
	float nxy11 = lerp(nx011, nx111, Blend.y);

	float nxyz0 = lerp(nxy00, nxy10, Blend.z);
	float nxyz1 = lerp(nxy01, nxy11, Blend.z);

	return lerp(nxyz0, nxyz1, Blend.w);
}

/**
 * 4D Gradient Noise
 * Used for seamless tiling
 * @param Position 4D input coordinates
 * @param Seed Optional seed for variation
 * @return Noise value in approximate range [-1, 1]
 */
float GradientNoise4D(float4 Position, float Seed = 0.f)
{
	float4 CellIndex = floor(Position);
	float4 LocalPosition = frac(Position);
	float4 Blend = LocalPosition * LocalPosition * LocalPosition
		* (LocalPosition * (LocalPosition * 6.0 - 15.0) + 10.0);

	// 16 corner gradient dot products
	float n0000 = dot(Gradient4D(CellIndex, Seed), LocalPosition);
	float n1000 = dot(
		Gradient4D(CellIndex + float4(1, 0, 0, 0), Seed),
		LocalPosition - float4(1, 0, 0, 0)
	);
	float n0100 = dot(
		Gradient4D(CellIndex + float4(0, 1, 0, 0), Seed),
		LocalPosition - float4(0, 1, 0, 0)
	);
	float n1100 = dot(
		Gradient4D(CellIndex + float4(1, 1, 0, 0), Seed),
		LocalPosition - float4(1, 1, 0, 0)
	);
	float n0010 = dot(
		Gradient4D(CellIndex + float4(0, 0, 1, 0), Seed),
		LocalPosition - float4(0, 0, 1, 0)
	);
	float n1010 = dot(
		Gradient4D(CellIndex + float4(1, 0, 1, 0), Seed),
		LocalPosition - float4(1, 0, 1, 0)
	);
	float n0110 = dot(
		Gradient4D(CellIndex + float4(0, 1, 1, 0), Seed),
		LocalPosition - float4(0, 1, 1, 0)
	);
	float n1110 = dot(
		Gradient4D(CellIndex + float4(1, 1, 1, 0), Seed),
		LocalPosition - float4(1, 1, 1, 0)
	);
	float n0001 = dot(
		Gradient4D(CellIndex + float4(0, 0, 0, 1), Seed),
		LocalPosition - float4(0, 0, 0, 1)
	);
	float n1001 = dot(
		Gradient4D(CellIndex + float4(1, 0, 0, 1), Seed),
		LocalPosition - float4(1, 0, 0, 1)
	);
	float n0101 = dot(
		Gradient4D(CellIndex + float4(0, 1, 0, 1), Seed),
		LocalPosition - float4(0, 1, 0, 1)
	);
	float n1101 = dot(
		Gradient4D(CellIndex + float4(1, 1, 0, 1), Seed),
		LocalPosition - float4(1, 1, 0, 1)
	);
	float n0011 = dot(
		Gradient4D(CellIndex + float4(0, 0, 1, 1), Seed),
		LocalPosition - float4(0, 0, 1, 1)
	);
	float n1011 = dot(
		Gradient4D(CellIndex + float4(1, 0, 1, 1), Seed),
		LocalPosition - float4(1, 0, 1, 1)
	);
	float n0111 = dot(
		Gradient4D(CellIndex + float4(0, 1, 1, 1), Seed),
		LocalPosition - float4(0, 1, 1, 1)
	);
	float n1111 = dot(
		Gradient4D(CellIndex + float4(1, 1, 1, 1), Seed),
		LocalPosition - float4(1, 1, 1, 1)
	);

	// 4D linear interpolation
	float nx000 = lerp(n0000, n1000, Blend.x);
	float nx100 = lerp(n0100, n1100, Blend.x);
	float nx010 = lerp(n0010, n1010, Blend.x);
	float nx110 = lerp(n0110, n1110, Blend.x);
	float nx001 = lerp(n0001, n1001, Blend.x);
	float nx101 = lerp(n0101, n1101, Blend.x);
	float nx011 = lerp(n0011, n1011, Blend.x);
	float nx111 = lerp(n0111, n1111, Blend.x);

	float nxy00 = lerp(nx000, nx100, Blend.y);
	float nxy10 = lerp(nx010, nx110, Blend.y);
	float nxy01 = lerp(nx001, nx101, Blend.y);
	float nxy11 = lerp(nx011, nx111, Blend.y);

	float nxyz0 = lerp(nxy00, nxy10, Blend.z);
	float nxyz1 = lerp(nxy01, nxy11, Blend.z);

	return lerp(nxyz0, nxyz1, Blend.w);
}

/**
 * 4D Perlin Noise (permutation table based)
 * Used for seamless tiling
 * @param Position 4D input coordinates
 * @return Noise value in approximate range [-1, 1]
 */
float PerlinNoise4D(float4 Position)
{
	// Perlin's permutation table
	static const int perm[512] = {
		151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,
		140,36,103,30,69,142,8,99,37,240,21,10,23,190,6,148,
		247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,
		57,177,33,88,237,149,56,87,174,20,125,136,171,168,68,175,
		74,165,71,134,139,48,27,166,77,146,158,231,83,111,229,122,
		60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,
		65,25,63,161,1,216,80,73,209,76,132,187,208,89,18,169,
		200,196,135,130,116,188,159,86,164,100,109,198,173,186,3,64,
		52,217,226,250,124,123,5,202,38,147,118,126,255,82,85,212,
		207,206,59,227,47,16,58,17,182,189,28,42,223,183,170,213,
		119,248,152,2,44,154,163,70,221,153,101,155,167,43,172,9,
		129,22,39,253,19,98,108,110,79,113,224,232,178,185,112,104,
		218,246,97,228,251,34,242,193,238,210,144,12,191,179,162,241,
		81,51,145,235,249,14,239,107,49,192,214,31,181,199,106,157,
		184,84,204,176,115,121,50,45,127,4,150,254,138,236,205,93,
		222,114,67,29,24,72,243,141,128,195,78,66,215,61,156,180,
		151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,
		140,36,103,30,69,142,8,99,37,240,21,10,23,190,6,148,
		247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,
		57,177,33,88,237,149,56,87,174,20,125,136,171,168,68,175,
		74,165,71,134,139,48,27,166,77,146,158,231,83,111,229,122,
		60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,
		65,25,63,161,1,216,80,73,209,76,132,187,208,89,18,169,
		200,196,135,130,116,188,159,86,164,100,109,198,173,186,3,64,
		52,217,226,250,124,123,5,202,38,147,118,126,255,82,85,212,
		207,206,59,227,47,16,58,17,182,189,28,42,223,183,170,213,
		119,248,152,2,44,154,163,70,221,153,101,155,167,43,172,9,
		129,22,39,253,19,98,108,110,79,113,224,232,178,185,112,104,
		218,246,97,228,251,34,242,193,238,210,144,12,191,179,162,241,
		81,51,145,235,249,14,239,107,49,192,214,31,181,199,106,157,
		184,84,204,176,115,121,50,45,127,4,150,254,138,236,205,93,
		222,114,67,29,24,72,243,141,128,195,78,66,215,61,156,180
	};

	int4 Cell = int4(floor(Position)) & 255;
	float4 LocalPosition = Position - floor(Position);
	float4 Blend = LocalPosition * LocalPosition * LocalPosition
		* (LocalPosition * (LocalPosition * 6.0 - 15.0) + 10.0);

	// 16 corner hash and gradient calculations
	int A = perm[Cell.x] + Cell.y;
	int AA = perm[A & 255] + Cell.z;
	int AB = perm[(A + 1) & 255] + Cell.z;
	int B = perm[(Cell.x + 1) & 255] + Cell.y;
	int BA = perm[B & 255] + Cell.z;
	int BB = perm[(B + 1) & 255] + Cell.z;

	int AAA = perm[AA & 255] + Cell.w;
	int AAB = perm[(AA + 1) & 255] + Cell.w;
	int ABA = perm[AB & 255] + Cell.w;
	int ABB = perm[(AB + 1) & 255] + Cell.w;
	int BAA = perm[BA & 255] + Cell.w;
	int BAB = perm[(BA + 1) & 255] + Cell.w;
	int BBA = perm[BB & 255] + Cell.w;
	int BBB = perm[(BB + 1) & 255] + Cell.w;

	float n0000 = Grad4D(perm[AAA & 255], LocalPosition);
	float n1000 = Grad4D(
		perm[BAA & 255],
		LocalPosition - float4(1, 0, 0, 0)
	);
	float n0100 = Grad4D(
		perm[ABA & 255],
		LocalPosition - float4(0, 1, 0, 0)
	);
	float n1100 = Grad4D(
		perm[BBA & 255],
		LocalPosition - float4(1, 1, 0, 0)
	);
	float n0010 = Grad4D(
		perm[AAB & 255],
		LocalPosition - float4(0, 0, 1, 0)
	);
	float n1010 = Grad4D(
		perm[BAB & 255],
		LocalPosition - float4(1, 0, 1, 0)
	);
	float n0110 = Grad4D(
		perm[ABB & 255],
		LocalPosition - float4(0, 1, 1, 0)
	);
	float n1110 = Grad4D(
		perm[BBB & 255],
		LocalPosition - float4(1, 1, 1, 0)
	);
	float n0001 = Grad4D(
		perm[(AAA + 1) & 255],
		LocalPosition - float4(0, 0, 0, 1)
	);
	float n1001 = Grad4D(
		perm[(BAA + 1) & 255],
		LocalPosition - float4(1, 0, 0, 1)
	);
	float n0101 = Grad4D(
		perm[(ABA + 1) & 255],
		LocalPosition - float4(0, 1, 0, 1)
	);
	float n1101 = Grad4D(
		perm[(BBA + 1) & 255],
		LocalPosition - float4(1, 1, 0, 1)
	);
	float n0011 = Grad4D(
		perm[(AAB + 1) & 255],
		LocalPosition - float4(0, 0, 1, 1)
	);
	float n1011 = Grad4D(
		perm[(BAB + 1) & 255],
		LocalPosition - float4(1, 0, 1, 1)
	);
	float n0111 = Grad4D(
		perm[(ABB + 1) & 255],
		LocalPosition - float4(0, 1, 1, 1)
	);
	float n1111 = Grad4D(
		perm[(BBB + 1) & 255],
		LocalPosition - float4(1, 1, 1, 1)
	);

	// 4D interpolation
	float nx000 = lerp(n0000, n1000, Blend.x);
	float nx100 = lerp(n0100, n1100, Blend.x);
	float nx010 = lerp(n0010, n1010, Blend.x);
	float nx110 = lerp(n0110, n1110, Blend.x);
	float nx001 = lerp(n0001, n1001, Blend.x);
	float nx101 = lerp(n0101, n1101, Blend.x);
	float nx011 = lerp(n0011, n1011, Blend.x);
	float nx111 = lerp(n0111, n1111, Blend.x);

	float nxy00 = lerp(nx000, nx100, Blend.y);
	float nxy10 = lerp(nx010, nx110, Blend.y);
	float nxy01 = lerp(nx001, nx101, Blend.y);
	float nxy11 = lerp(nx011, nx111, Blend.y);

	float nxyz0 = lerp(nxy00, nxy10, Blend.z);
	float nxyz1 = lerp(nxy01, nxy11, Blend.z);

	return lerp(nxyz0, nxyz1, Blend.w);
}

/**
 * Map 2D UV to 4D torus for seamless tiling
 * Wraps 2D plane onto 4D torus surface
 *
 * @param UV 2D texture coordinates [0, 1]
 * @param Scale Torus radius scale
 * @return 4D position on torus surface
 */
float4 TorusMap(float2 UV, float Scale)
{
	float2 Angle = UV * 2.0 * PI;
	return float4(
		cos(Angle.x),
		sin(Angle.x),
		cos(Angle.y),
		sin(Angle.y)
	) * Scale;
}

/**
 * Seamless 2D Value Noise (via 4D torus mapping)
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @return Seamlessly tiling noise value
 */
float SeamlessValueNoise(float2 UV, float Scale)
{
	float4 TorusPosition = TorusMap(UV, Scale);
	return ValueNoise4D(TorusPosition);
}

/**
 * Seamless 2D Gradient Noise (via 4D torus mapping)
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @param Seed Optional seed for variation
 * @return Seamlessly tiling noise value
 */
float SeamlessGradientNoise(float2 UV, float Scale, float Seed = 0.f)
{
	float4 TorusPosition = TorusMap(UV, Scale);
	return GradientNoise4D(TorusPosition, Seed);
}

/**
 * Seamless 2D Perlin Noise (via 4D torus mapping)
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @return Seamlessly tiling noise value
 */
float SeamlessPerlinNoise(float2 UV, float Scale)
{
	float4 TorusPosition = TorusMap(UV, Scale);
	return PerlinNoise4D(TorusPosition);
}

/**
 * Seamless 2D Simplex Noise (via 4D torus mapping)
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @param Seed Optional seed for variation
 * @return Seamlessly tiling noise value
 */
float SeamlessSimplexNoise(float2 UV, float Scale, float Seed = 0.f)
{
	float4 TorusPosition = TorusMap(UV, Scale);
	return SimplexNoise4D(TorusPosition, Seed);
}

/**
 * 2D Simplex Noise with analytic gradient
 * Computes both noise value and its gradient simultaneously
 * More efficient than finite differences
 *
 * @param Position Input coordinates
 * @param Seed Variation seed
 * @param OutValue Output noise value
 * @param OutGradient Output gradient vector (∂n/∂x, ∂n/∂y)
 */
void SimplexNoise2DWithGradient(
	float2 Position,
	float Seed,
	out float OutValue,
	out float2 OutGradient
)
{
	const float SKEW_2D = 0.36602540378f;
	const float UNSKEW_2D = 0.21132486540f;

	// Skew input space
	float SkewOffset = (Position.x + Position.y) * SKEW_2D;
	float2 Skewed = Position + SkewOffset;
	float2 Cell = floor(Skewed);

	// Unskew back
	float UnskewOffset = (Cell.x + Cell.y) * UNSKEW_2D;
	float2 CellOrigin = Cell - UnskewOffset;
	float2 Offset0 = Position - CellOrigin;

	// Determine triangle
	float2 Offset1 = (Offset0.x > Offset0.y)
		? float2(1.0, 0.0)
		: float2(0.0, 1.0);

	// Distance vectors to corners
	float2 Offset1Pos = Offset0 - Offset1 + UNSKEW_2D;
	float2 Offset2Pos = Offset0 - 1.0 + 2.0 * UNSKEW_2D;

	// Gradients
	float2 Grad0 = Gradient(Cell, Seed);
	float2 Grad1 = Gradient(Cell + Offset1, Seed);
	float2 Grad2 = Gradient(Cell + 1.0, Seed);

	// Falloff (t = 0.5 - r^2)
	float3 Falloff = max(0.0, 0.5 - float3(
		dot(Offset0, Offset0),
		dot(Offset1Pos, Offset1Pos),
		dot(Offset2Pos, Offset2Pos)
	));

	// t^2, t^3, t^4
	float3 Falloff2 = Falloff * Falloff;
	float3 Falloff3 = Falloff2 * Falloff;
	float3 Falloff4 = Falloff2 * Falloff2;

	// Gradient dot products
	float3 GradDot = float3(
		dot(Grad0, Offset0),
		dot(Grad1, Offset1Pos),
		dot(Grad2, Offset2Pos)
	);

	// Noise value
	OutValue = 70.0 * dot(Falloff4, GradDot);

	// Analytic gradient: d(t^4 * g·d)/dPos = t^4 * g - 8 * t^3 * (g·d) * d
	float2 GradientSum = Falloff4.x * Grad0 - 8.0 * Falloff3.x * GradDot.x * Offset0
		+ Falloff4.y * Grad1 - 8.0 * Falloff3.y * GradDot.y * Offset1Pos
		+ Falloff4.z * Grad2 - 8.0 * Falloff3.z * GradDot.z * Offset2Pos;
	OutGradient = 70.0 * GradientSum;
}

/**
 * FBM loop macro
 * Implements Fractional Brownian Motion pattern
 * Adds octave offset for better variation between octaves
 */
#define FBM_LOOP(RETURN_TYPE, OCTAVES, LACUNARITY, GAIN, AMPLITUDE, NOISE_CALL) \
	RETURN_TYPE Total = (RETURN_TYPE)0; \
	float Amplitude = AMPLITUDE, Frequency = 1.f, MaxValue = 0.f; \
	[loop] for (int i = 0; i < OCTAVES; i++) { \
		float2 OctaveOffset = float2(i * 127.0, i * 311.0); \
		Total += (NOISE_CALL) * Amplitude; \
		MaxValue += Amplitude; \
		Frequency *= LACUNARITY; \
		Amplitude *= GAIN; \
	} \
	return Total / MaxValue;

/**
 * Simplex FBM (Fractional Brownian Motion)
 * Combines multiple octaves of simplex noise
 *
 * @param Position Input coordinates
 * @param Octaves Number of noise layers
 * @param Lacunarity Frequency multiplier per octave (typically 2.0)
 * @param Gain Amplitude multiplier per octave (typically 0.5)
 * @param InitialAmplitude Starting amplitude
 * @param Seed Variation seed
 * @return Combined multi-octave noise value
 */
float SimplexFBM(
	float2 Position,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude,
	float Seed = 0.f
)
{
	FBM_LOOP(
		float,
		Octaves,
		Lacunarity,
		Gain,
		InitialAmplitude,
		SimplexNoise2D((Position + OctaveOffset) * Frequency, Seed)
	)
}

/**
 * Sample scalar potential field for curl noise
 * @param Position Input position
 * @param Frequency Noise frequency
 * @param Time Animation time
 * @param AnimDirection Animation drift direction
 * @param Seed Variation seed
 * @return Scalar potential value
 */
float SamplePotentialField(
	float2 Position,
	float Frequency,
	float Time,
	float2 AnimDirection,
	float Seed = 0.0
)
{
	float2 ScaledPosition = Position * Frequency;
	ScaledPosition += AnimDirection * Time;
	return SimplexNoise2D(ScaledPosition, Seed);
}

/**
 * 2D Curl Noise (analytic derivative version)
 * Computes divergence-free vector field from scalar potential
 * Curl formula: (∂ψ/∂y, -∂ψ/∂x)
 *
 * @param Position Input position
 * @param Frequency Noise frequency
 * @param Time Animation time
 * @param AnimDirection Animation drift direction
 * @return Divergence-free velocity field
 */
float2 CurlNoise2D(
	float2 Position,
	float Frequency,
	float Time,
	float2 AnimDirection = float2(0.1, 0)
)
{
	// Transform to noise space
	float2 ScaledPosition = Position * Frequency + AnimDirection * Time;

	// Compute value and gradient analytically
	float Value;
	float2 NoiseGradient;
	SimplexNoise2DWithGradient(ScaledPosition, 0.0, Value, NoiseGradient);

	// Transform gradient to position space (chain rule)
	NoiseGradient *= Frequency;

	// Curl formula: (∂ψ/∂y, -∂ψ/∂x)
	return float2(NoiseGradient.y, -NoiseGradient.x);
}

/**
 * Value FBM
 * @param Position Input coordinates
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @return Multi-octave value noise
 */
float ValueFBM(
	float2 Position,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude
)
{
	FBM_LOOP(
		float,
		Octaves,
		Lacunarity,
		Gain,
		InitialAmplitude,
		ValueNoise2D((Position + OctaveOffset) * Frequency)
	)
}

/**
 * Gradient FBM
 * @param Position Input coordinates
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @return Multi-octave gradient noise
 */
float GradientFBM(
	float2 Position,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude
)
{
	FBM_LOOP(
		float,
		Octaves,
		Lacunarity,
		Gain,
		InitialAmplitude,
		GradientNoise2D((Position + OctaveOffset) * Frequency)
	)
}

/**
 * Perlin FBM
 * @param Position Input coordinates
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @return Multi-octave Perlin noise
 */
float PerlinFBM(
	float2 Position,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude
)
{
	FBM_LOOP(
		float,
		Octaves,
		Lacunarity,
		Gain,
		InitialAmplitude,
		PerlinNoise2D((Position + OctaveOffset) * Frequency)
	)
}

/**
 * Curl Noise FBM
 * Multi-octave divergence-free vector field
 *
 * @param Position Input coordinates
 * @param BaseFrequency Starting frequency
 * @param Time Animation time
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @param AnimDirection Animation drift direction
 * @return Multi-octave curl noise vector
 */
float2 CurlNoiseFBM(
	float2 Position,
	float BaseFrequency,
	float Time,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude,
	float2 AnimDirection = float2(0.1, 0.15)
)
{
	FBM_LOOP(
		float2,
		Octaves,
		Lacunarity,
		Gain,
		InitialAmplitude,
		CurlNoise2D(
			Position + OctaveOffset,
			Frequency * BaseFrequency,
			Time,
			AnimDirection
		)
	)
}

/**
 * Seamless Value FBM (torus-mapped)
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @return Seamlessly tiling multi-octave noise
 */
float SeamlessValueFBM(
	float2 UV,
	float Scale,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude
)
{
	float Total = 0.0;
	float Amplitude = InitialAmplitude;
	float CurrentScale = Scale;
	float MaxValue = 0.0;

	[loop]
	for (int i = 0; i < Octaves; i++)
	{
		// UV offset for octave variation (no seed in ValueNoise4D)
		float2 OctaveUV = UV + float2(i * 0.123, i * 0.456);
		Total += SeamlessValueNoise(OctaveUV, CurrentScale) * Amplitude;
		MaxValue += Amplitude;
		CurrentScale *= Lacunarity;
		Amplitude *= Gain;
	}

	return Total / MaxValue;
}

/**
 * Seamless Gradient FBM (torus-mapped)
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @param Seed Variation seed
 * @return Seamlessly tiling multi-octave noise
 */
float SeamlessGradientFBM(
	float2 UV,
	float Scale,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude,
	float Seed = 0.f
)
{
	float Total = 0.0;
	float Amplitude = InitialAmplitude;
	float CurrentScale = Scale;
	float MaxValue = 0.0;

	[loop]
	for (int i = 0; i < Octaves; i++)
	{
		float OctaveSeed = Seed + i * 127.0;
		Total += SeamlessGradientNoise(UV, CurrentScale, OctaveSeed) * Amplitude;
		MaxValue += Amplitude;
		CurrentScale *= Lacunarity;
		Amplitude *= Gain;
	}

	return Total / MaxValue;
}

/**
 * Seamless Perlin FBM (torus-mapped)
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @return Seamlessly tiling multi-octave noise
 */
float SeamlessPerlinFBM(
	float2 UV,
	float Scale,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude
)
{
	float Total = 0.0;
	float Amplitude = InitialAmplitude;
	float CurrentScale = Scale;
	float MaxValue = 0.0;

	[loop]
	for (int i = 0; i < Octaves; i++)
	{
		// UV offset for octave variation
		float2 OctaveUV = UV + float2(i * 0.789, i * 0.321);
		Total += SeamlessPerlinNoise(OctaveUV, CurrentScale) * Amplitude;
		MaxValue += Amplitude;
		CurrentScale *= Lacunarity;
		Amplitude *= Gain;
	}

	return Total / MaxValue;
}

/**
 * Seamless Simplex FBM (torus-mapped)
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @param Seed Variation seed
 * @return Seamlessly tiling multi-octave noise
 */
float SeamlessSimplexFBM(
	float2 UV,
	float Scale,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude,
	float Seed = 0.f
)
{
	float Total = 0.0;
	float Amplitude = InitialAmplitude;
	float CurrentScale = Scale;
	float MaxValue = 0.0;

	[loop]
	for (int i = 0; i < Octaves; i++)
	{
		float OctaveSeed = Seed + i * 127.0;
		Total += SeamlessSimplexNoise(UV, CurrentScale, OctaveSeed) * Amplitude;
		MaxValue += Amplitude;
		CurrentScale *= Lacunarity;
		Amplitude *= Gain;
	}

	return Total / MaxValue;
}

/**
 * Seamless Curl Noise (finite difference)
 * Uses numerical derivative of seamless simplex noise
 *
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @param Seed Variation seed
 * @return Divergence-free vector field (seamlessly tiling)
 */
float2 SeamlessCurlNoise(
	float2 UV,
	float Scale,
	float Seed = 0.f
)
{
	// Small offset for numerical derivative
	const float Epsilon = 0.001;

	// Sample scalar potential field
	float Right = SeamlessSimplexNoise(UV + float2(Epsilon, 0), Scale, Seed);
	float Left = SeamlessSimplexNoise(UV - float2(Epsilon, 0), Scale, Seed);
	float Up = SeamlessSimplexNoise(UV + float2(0, Epsilon), Scale, Seed);
	float Down = SeamlessSimplexNoise(UV - float2(0, Epsilon), Scale, Seed);

	// Partial derivatives
	float dNdx = (Right - Left) / (2.0 * Epsilon);
	float dNdy = (Up - Down) / (2.0 * Epsilon);

	// Curl: (∂N/∂y, -∂N/∂x)
	return float2(dNdy, -dNdx);
}

/**
 * Seamless Curl Noise FBM
 * Multi-octave seamlessly tiling curl noise
 *
 * @param UV Texture coordinates [0, 1]
 * @param Scale Noise scale
 * @param Octaves Number of octaves
 * @param Lacunarity Frequency multiplier
 * @param Gain Amplitude multiplier
 * @param InitialAmplitude Starting amplitude
 * @param Seed Variation seed
 * @return Seamlessly tiling curl vector field
 */
float2 SeamlessCurlNoiseFBM(
	float2 UV,
	float Scale,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude,
	float Seed = 0.f
)
{
	float2 Total = float2(0.0, 0.0);
	float Amplitude = InitialAmplitude;
	float CurrentScale = Scale;
	float MaxValue = 0.0;

	[loop]
	for (int i = 0; i < Octaves; i++)
	{
		float OctaveSeed = Seed + i * 127.0;
		Total += SeamlessCurlNoise(UV, CurrentScale, OctaveSeed) * Amplitude;
		MaxValue += Amplitude;
		CurrentScale *= Lacunarity;
		Amplitude *= Gain;
	}

	return Total / MaxValue;
}

/**
 * Calculate plane alignment offset for ray marching
 * Ensures samples align with view-aligned planes
 *
 * @param TEntry Entry point parameter along ray
 * @param CamToBoxCenter Distance from camera to box center
 * @param StepSize Ray marching step size
 * @return Offset to align with nearest plane
 */
float GetPlaneAlignmentOffset(
	float TEntry,
	float CamToBoxCenter,
	float StepSize
)
{
	return 1 - frac((TEntry - CamToBoxCenter) / StepSize) * StepSize;
}

/**
 * Domain Warping
 * Advanced noise technique that warps input coordinates using noise
 * Creates organic, flowing patterns with high visual complexity
 *
 * @param NumWarps Number of warping iterations
 * @param WarpStrength Initial warp displacement strength
 * @param WarpFalloff Strength decay per iteration
 * @param WarpContrast Final output contrast adjustment
 * @param AnimStrength Animation displacement magnitude
 * @param Time Current animation time
 * @param XScale Noise scale for X-axis warping
 * @param YScale Noise scale for Y-axis warping
 * @param ResultScale Final noise sample scale
 * @param XOffset Offset for X-axis noise sampling
 * @param YOffset Offset for Y-axis noise sampling
 * @param ResultOffset Offset for final noise sampling
 * @param Position Input coordinates
 * @param Octaves FBM octave count
 * @param Lacunarity FBM frequency multiplier
 * @param Gain FBM amplitude multiplier
 * @param InitialAmplitude FBM starting amplitude
 * @param Seed Variation seed
 * @return Domain-warped noise value [0, 1]
 */
float DomainWarping(
	int NumWarps,
	float WarpStrength,
	float WarpFalloff,
	float WarpContrast,
	float AnimStrength,
	float Time,
	float XScale,
	float YScale,
	float ResultScale,
	float2 XOffset,
	float2 YOffset,
	float2 ResultOffset,
	float2 Position,
	int Octaves,
	float Lacunarity,
	float Gain,
	float InitialAmplitude,
	float Seed = 0.f
)
{
	float CurrentWarpScale = WarpStrength;
	float SeedOffset = 1000.f;

	// Animated time offsets with different frequencies
	float2 TimeOffset1 = float2(
		sin(Time * 0.3),
		cos(Time * 0.2)
	) * AnimStrength;
	float2 TimeOffset2 = float2(
		cos(Time * 0.4),
		sin(Time * 0.25)
	) * AnimStrength;
	float2 TimeOffset3 = float2(
		sin(Time * 0.35),
		cos(Time * 0.15)
	) * AnimStrength;

	// Iterative domain warping
	[loop]
	for (int i = 0; i < NumWarps; i++)
	{
		float dx = SimplexFBM(
			(Position + XOffset + TimeOffset1) * XScale,
			Octaves,
			Lacunarity,
			Gain,
			InitialAmplitude,
			Seed
		);
		float dy = SimplexFBM(
			(Position + YOffset + TimeOffset2) * YScale,
			Octaves,
			Lacunarity,
			Gain,
			InitialAmplitude,
			Seed + SeedOffset
		);

		Position.x += CurrentWarpScale * dx;
		Position.y += CurrentWarpScale * dy;

		CurrentWarpScale *= WarpFalloff;
	}

	// Final noise sample on warped domain
	float WarpedNoise = SimplexFBM(
		(Position + ResultOffset + TimeOffset3) * ResultScale,
		Octaves,
		Lacunarity,
		Gain,
		InitialAmplitude,
		Seed + SeedOffset * 2
	) * 0.5 + 0.5;

	return pow(WarpedNoise, WarpContrast);
}

float2 SineShake(float2 uv, float time)
{
    float shakeX = sin(uv.y * 10.0 + time * 2.0) * 0.01;
    shakeX += sin(uv.y * 25.6 + time * 4.3) * 0.005;
    
    float shakeY = cos(uv.x * 12.3 + time * 2.5) * 0.01;
    shakeY += cos(uv.x * 28.1 + time * 5.1) * 0.004;
    
    return float2(shakeX, shakeY);
}