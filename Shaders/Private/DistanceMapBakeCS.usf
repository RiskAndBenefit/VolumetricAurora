/**
 * DistanceMapBakeCS.usf
 * Jump Flooding Algorithm (JFA) for Distance Field generation
 * Generates signed distance field with normals from binary obstacle mask
 *
 * Pipeline: Initialize -> Jump Flooding (multiple passes) -> Finalize
 * Output: RGBA texture (RG=Normal, B=Distance, A=Mask)
 */

#include "/Engine/Public/Platform.ush"

// ============================================================================
// PASS 1: Initialize - Convert mask to seed coordinates
// ============================================================================

Texture2D<float4> InputMask;
SamplerState InputSampler;
RWTexture2D<float4> SeedBuffer;

/**
 * Initialize seed buffer from obstacle mask
 * Each obstacle pixel stores its own coordinates as seed
 * Empty pixels store (-1, -1) as invalid marker
 */
[numthreads(8, 8, 1)]
void InitializeCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	uint2 TextureSize;
	SeedBuffer.GetDimensions(TextureSize.x, TextureSize.y);

	if (DispatchThreadID.x >= TextureSize.x || DispatchThreadID.y >= TextureSize.y)
		return;

	float2 UV = (float2(DispatchThreadID.xy) + 0.5) / float2(TextureSize);
	float4 MaskSample = InputMask.SampleLevel(InputSampler, UV, 0);

	// Use blue channel for obstacle detection
	float ObstacleValue = MaskSample.b;

	// If obstacle (bright pixel), store own coordinates as seed
	// Otherwise store invalid marker (-1, -1)
	if (ObstacleValue > 0.5)
	{
		SeedBuffer[DispatchThreadID.xy] = float4(float2(DispatchThreadID.xy), 0, 0);
	}
	else
	{
		SeedBuffer[DispatchThreadID.xy] = float4(-1, -1, 0, 0);
	}
}

// ============================================================================
// PASS 2: Jump Flooding - Propagate nearest seed information
// ============================================================================

Texture2D<float4> InputSeeds;
RWTexture2D<float4> OutputSeeds;
int JumpStep;

/**
 * Jump Flooding Algorithm pass
 * Checks 3x3 neighborhood at JumpStep distance
 * Keeps seed that produces minimum distance to current pixel
 */
[numthreads(8, 8, 1)]
void JumpFloodingCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	uint2 TextureSize;
	OutputSeeds.GetDimensions(TextureSize.x, TextureSize.y);

	if (DispatchThreadID.x >= TextureSize.x || DispatchThreadID.y >= TextureSize.y)
		return;

	float2 CurrentPosition = float2(DispatchThreadID.xy);
	float4 CurrentSeed = InputSeeds[DispatchThreadID.xy];
	float2 BestSeed = CurrentSeed.xy;

	// Calculate current best distance
	float BestDistance = (BestSeed.x < 0)
		? 999999.0
		: length(CurrentPosition - BestSeed);

	// Check 9 neighbors in 3x3 grid at JumpStep intervals
	for (int dy = -1; dy <= 1; dy++)
	{
		for (int dx = -1; dx <= 1; dx++)
		{
			int2 NeighborCoord = int2(DispatchThreadID.xy) + int2(dx, dy) * JumpStep;

			// Boundary check
			if (NeighborCoord.x < 0 || NeighborCoord.x >= (int)TextureSize.x ||
				NeighborCoord.y < 0 || NeighborCoord.y >= (int)TextureSize.y)
				continue;

			float4 NeighborSeed = InputSeeds[NeighborCoord];

			// Skip invalid seeds
			if (NeighborSeed.x < 0)
				continue;

			float Distance = length(CurrentPosition - NeighborSeed.xy);

			if (Distance < BestDistance)
			{
				BestDistance = Distance;
				BestSeed = NeighborSeed.xy;
			}
		}
	}

	OutputSeeds[DispatchThreadID.xy] = float4(BestSeed, 0, 0);
}

// ============================================================================
// PASS 3: Finalize - Calculate distance and normals, encode to RGBA
// ============================================================================

Texture2D<float4> SeedBufferFinal;
SamplerState SeedSampler;
Texture2D<float4> MaskInput;
SamplerState MaskSampler;
RWTexture2D<float4> OutputTexture;

/**
 * Finalize distance map
 * Computes final distance and normals from JFA result
 * Encodes to RGBA: RG=Normal, B=Distance, A=Mask
 */
[numthreads(8, 8, 1)]
void FinalizeCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
	uint2 TextureSize;
	OutputTexture.GetDimensions(TextureSize.x, TextureSize.y);

	if (DispatchThreadID.x >= TextureSize.x || DispatchThreadID.y >= TextureSize.y)
		return;

	float2 CurrentPosition = float2(DispatchThreadID.xy);
	float2 UV = (CurrentPosition + 0.5) / float2(TextureSize);

	// Sample original mask (use blue channel for obstacles)
	float4 MaskSample = MaskInput.SampleLevel(MaskSampler, UV, 0);
	float ObstacleValue = MaskSample.b;
	float Mask = (ObstacleValue > 0.5) ? 1.0 : 0.0;

	// Get nearest obstacle coordinate from JFA
	float4 SeedData = SeedBufferFinal[DispatchThreadID.xy];
	float2 NearestObstacle = SeedData.xy;

	float Distance = 0.0;
	float2 Normal = float2(0, 0);

	if (Mask > 0.5)
	{
		// Inside obstacle: distance = 0, compute edge normal from gradient
		Distance = 0.0;

		// Sample neighbors to compute gradient (edge detection) - use blue channel
		float2 PixelSize = 1.0 / float2(TextureSize);
		float Left = MaskInput.SampleLevel(
			MaskSampler,
			UV + float2(-PixelSize.x, 0),
			0
		).b;
		float Right = MaskInput.SampleLevel(
			MaskSampler,
			UV + float2(PixelSize.x, 0),
			0
		).b;
		float Down = MaskInput.SampleLevel(
			MaskSampler,
			UV + float2(0, -PixelSize.y),
			0
		).b;
		float Up = MaskInput.SampleLevel(
			MaskSampler,
			UV + float2(0, PixelSize.y),
			0
		).b;

		// Gradient pointing outward (from inside/bright to outside/dark)
		float2 Gradient = float2(Right - Left, Up - Down);
		float GradientLength = length(Gradient);

		if (GradientLength > 0.01)
		{
			Normal = normalize(Gradient);
		}
		else
		{
			// Interior pixel far from edge, use safe default
			Normal = float2(0, 1);
		}
	}
	else if (NearestObstacle.x >= 0)
	{
		// Outside obstacle: use JFA result
		float2 Offset = CurrentPosition - NearestObstacle;
		Distance = length(Offset);

		if (Distance > 0.001)
		{
			Normal = normalize(Offset);
		}
		else
		{
			// Shouldn't happen, but safe fallback
			Normal = float2(0, 1);
		}
	}
	else
	{
		// No obstacle found anywhere (empty image)
		Distance = float(TextureSize.x);
		Normal = float2(0, 1);
	}

	// Normalize distance to UV space (0~1)
	// Dividing by texture size converts pixel distance to UV distance
	float NormalizedDistance = saturate(Distance / float(TextureSize.x));

	// Encode to RGBA
	// R: Normal X [-1,1] -> [0,1]
	// G: Normal Y [-1,1] -> [0,1]
	// B: Distance in UV space [0,1]
	// A: Mask (1=obstacle, 0=empty)
	OutputTexture[DispatchThreadID.xy] = float4(
		Normal.x * 0.5 + 0.5,
		Normal.y * 0.5 + 0.5,
		NormalizedDistance,
		Mask
	);
}
