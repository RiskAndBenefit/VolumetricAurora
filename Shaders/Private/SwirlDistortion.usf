#include "/Engine/Public/Platform.ush"

RWTexture2D<float4> RenderTarget;
Texture2D<float4> InputNoiseTex;
SamplerState InputNoiseSampler;

float SwirlStrength;
float SwirlRadius;
float2 SwirlCenter;

#define PI 3.14159265359

float2 ApplySwirl(float2 uv, float2 center, float strength, float radius)
{
    float2 delta = uv - center;
    float dist = length(delta);
    float angle = atan2(delta.y, delta.x);
    
    if (dist < radius)
    {
        float falloff = 1.0 - (dist / radius);
        float rotation = strength * falloff * PI;
        angle += rotation;
        
        return center + float2(cos(angle), sin(angle)) * dist;
    }
    
    return uv;
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(
    uint3 DispatchThreadId : SV_DispatchThreadID,
    uint3 GroupThreadId : SV_GroupThreadID)
{
    uint2 TextureSize;
    RenderTarget.GetDimensions(TextureSize.x, TextureSize.y);
    
    // Bounds check
    if (DispatchThreadId.x >= TextureSize.x || DispatchThreadId.y >= TextureSize.y)
    {
        return;
    }
    
    // UV 계산 (0~1 범위)
    float2 UV = (float2(DispatchThreadId.xy) + 0.5) / float2(TextureSize);
    
    // Swirl 효과 적용
    float2 SwirlUV = ApplySwirl(UV, SwirlCenter, SwirlStrength, SwirlRadius);
    
    // Swirl된 UV로 Input 텍스처 샘플링
    float4 Color = InputNoiseTex.SampleLevel(InputNoiseSampler, SwirlUV, 0);
    
    RenderTarget[DispatchThreadId.xy] = Color;
}