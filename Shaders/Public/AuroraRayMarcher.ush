#pragma once

#include "../Private/AuroraNoise.ush"

// ==================================================================================
// CONSTANTS & DEFINITIONS
// ==================================================================================

#ifndef AURORA_RAYMARCH_STEPS
#define AURORA_RAYMARCH_STEPS 64
#endif

static const int RadialFadeType = 0;
static const int BoxFadeType = 1;

// ==================================================================================
// PARAMETER STRUCTS
// ==================================================================================

// [Common] 모든 오로라 타입이 공유하는 기본 파라미터
struct FAuroraBaseParams
{
    // Ray & Box
    float3 RayOrigin;
    float3 RayDir;
    float3 BoxExtent;
    
    // Time & Space
    float AccumulatedTime;
    float UnscaledTime;
    float EnterLen;
    float ExitLen;
    float Jitter;
    
    // Base Properties
    float Density;
    float Speed;
    
    // Fade Settings
    int EdgeFadeMode; // 0: Radial, 1: Box
    float EdgeFadeSoftness;
    float HeightFalloff;
    
    // Color Palette
    float4 TopColor;
    float4 MidColor;
    float4 BottomColor;
    float2 MidColorHeight; // x: Start, y: End
    
    float bUseStraightAlphaPalette; // true = Straight Alpha, false = Premultiplied Alpha
    float ColorShiftStrength;
    
    // Structure Coloring (Noise Only)
    float bEnableStructureColoring;
    float3 SoftTint;
    float3 CoreTint;
    
    // Tone Shaping (Post-Accumulation)
    // Contrast Shaping = "Tone Remapping"
    // * 모든 누적이 끝난 뒤, 이미 만들어진 Color의 밝기 분포를 바꿈
    // * pivot을 기준으로 밝은 건 더 밝게, 어두운 건 더 어둡게 하니까
    // * 전체 톤 대비 변화가 존재하고, 톤 커브로 분위기/룩을 조정하는 역할 (색상 공간에서의 재매핑)
    float EmissiveTonePivot; // 톤 재분배의 기준 밝기
    float EmissiveContrast;
    float EmissiveSaturation;
    
    // Emissive Structure (Noise Only)
    // ART LAYER = "Structure Selection"
    // * ray marching 중, 스텝 단위에서 이 스텝의 발광이 구조적으로 의미가 있어 더 누적될건지 판단
    // * 잡음성 발광이 제거되고 형태가 살아남아 띠가 또렷해짐 (쌓이는 과정 자체를 선택적으로 필터링) 
    float bEnableEmissiveStructure; // 구조 강조 적용 여부
    float EmissiveStructurePivot; // 구조적으로 의미 있는 발광 기준
    float EmissiveStructureSelectivity; // 구조 강조 강도 (얼마나 남길지)
};

// [Noise Aurora Only] 노이즈 기반 오로라 전용 파라미터
struct FNoiseAuroraParams
{
    // Shape Control
    float ShapeFrequency;
    float2 ScrollVelocity;
    float Smoothness;
    
    // Mask Control
    float MaskFrequency;
    float2 MaskScrollVelocity;
    float MaskOpacity;
};

// [Spline Aurora Only] 스플라인 기반 오로라 전용 파라미터
struct FSplineAuroraParams
{
    float Thickness;
    float Distortion;
    float DistortionHeightFalloff;
};

// [Flow Aurora Only] 유체 시뮬레이션 기반 오로라 전용 파라미터
struct FFlowAuroraParams
{
    // 추후 확장을 위한 패딩 (16바이트 정렬 고려 시 float 3개 더 추가 가능)
    float _Padding;
};

// [Output] 레이마칭 결과
struct FRayMarchResult
{
    float Density;
    float3 Color;
};

// ==================================================================================
// RAY MARCHER LOGIC
// ==================================================================================

struct FRayMarcher
{
    FAuroraBaseParams BaseParams;

    // ------------------------------------------------------------------------------
    // Utility Functions
    // ------------------------------------------------------------------------------
    
    float CalculateFade(float3 RayPoint)
    {
        float DistanceFromCenter = 0.0;
        [branch]
        switch (BaseParams.EdgeFadeMode)
        {
            case BoxFadeType:
                DistanceFromCenter = max(abs(RayPoint.x), abs(RayPoint.y));
                break;
            case RadialFadeType:
            default:
                DistanceFromCenter = sqrt(RayPoint.x * RayPoint.x + RayPoint.y * RayPoint.y);
                break;
        }

        float NormalizedDist = DistanceFromCenter / BaseParams.BoxExtent.x;
        float FadeThreshold = 1.0 - saturate(BaseParams.EdgeFadeSoftness);
        return smoothstep(1.0, FadeThreshold, NormalizedDist);
    }

    float4 CalculateColor(float NormalizedHeight)
    {
        float H = saturate(NormalizedHeight);
        float MidStart = saturate(BaseParams.MidColorHeight.x);
        float MidEnd = max(saturate(BaseParams.MidColorHeight.y), MidStart + 0.0001);

        float UseStraight = BaseParams.bUseStraightAlphaPalette ? 1.0 : 0.0;
        
        // 1. Un-premultiply logic for blending (기존과 동일)
        float4 Bottom = BaseParams.BottomColor;
        float4 Mid = BaseParams.MidColor;
        float4 Top = BaseParams.TopColor;
        
        // 블렌딩을 위해 임시로 Premultiply (Straight 모드면 그냥 둠)
        float4 BottomBlend = float4(lerp(Bottom.rgb * Bottom.a, Bottom.rgb, UseStraight), Bottom.a);
        float4 MidBlend = float4(lerp(Mid.rgb * Mid.a, Mid.rgb, UseStraight), Mid.a);
        float4 TopBlend = float4(lerp(Top.rgb * Top.a, Top.rgb, UseStraight), Top.a);
        
        float BlendBottomMid = saturate(H / max(MidStart, 1e-6));
        float4 Color = lerp(BottomBlend, MidBlend, BlendBottomMid);
        
        float MidMask = smoothstep(MidStart, MidEnd, H);
        float BlendMidTop = saturate((H - MidEnd) / (1.0 - MidEnd));
        Color = lerp(Color, lerp(MidBlend, TopBlend, BlendMidTop), MidMask);
        
        // 리턴은 항상 Straight RGB + Alpha 형태
        float FinalAlpha = saturate(Color.a);
        
        // Premultiplied(UseStraight=0)라면 Alpha로 나눠서 RGB를 복구
        float3 StraightRGB = (FinalAlpha > 1e-6) ? (Color.rgb / max(FinalAlpha, 1e-6)) : float3(0, 0, 0);
        
        // Straight모드라면 Color.rgb가 이미 Straight이므로 그대로 사용
        float3 OutputRGB = lerp(StraightRGB, Color.rgb, UseStraight);

        return float4(OutputRGB, FinalAlpha);
    }

    float3 ApplyToneShaping(float3 Color)
    {
        float Luminance = dot(Color, float3(0.299, 0.587, 0.114));
        float Pivot = max(BaseParams.EmissiveTonePivot, 1e-6);
        
        float Normalized = pow(Luminance / Pivot, BaseParams.EmissiveContrast);
        float AdjustedLum = Normalized * Pivot;
        
        Color *= (Luminance > 1e-6) ? (AdjustedLum / Luminance) : 0.0;
        return lerp(Luminance.xxx, Color, BaseParams.EmissiveSaturation);
    }

    // ------------------------------------------------------------------------------
    // Density Calculation Kernels (Type Specific)
    // ------------------------------------------------------------------------------

    float GetDensity_Noise(
        FNoiseAuroraParams Params,
        float2 BaseUV,
        float NormalizedHeight,
        float HeightFalloff,
        float PathLenRatio,
        float TransmitFactor,
        float VoronoiVal,
        Texture2D ShapeTex, SamplerState ShapeSampler,
        Texture2D NoiseTex, SamplerState NoiseSampler,
        FAuroraBaseParams BaseParams
    )
    {
        float Speed = BaseParams.AccumulatedTime * 0.005f;
        
        float2 CenterOff = float2(Params.ShapeFrequency, Params.ShapeFrequency) * 0.5f - 0.5f;
        float2 AuroraUV = BaseUV * Params.ShapeFrequency - CenterOff;
        AuroraUV += Params.ScrollVelocity * BaseParams.AccumulatedTime;

        float2 MaskUV = BaseUV * Params.MaskFrequency - (float2(Params.MaskFrequency, Params.MaskFrequency) * 0.5 - 0.5);
        MaskUV += Params.MaskScrollVelocity * BaseParams.AccumulatedTime;
            
        float MaskNoise = smoothstep(0.1, 0.9, NoiseTex.SampleLevel(NoiseSampler, frac(MaskUV), 0).g);
        MaskNoise = lerp(1.0, MaskNoise, saturate(Params.MaskOpacity));

        float2 UV1 = frac(AuroraUV + float2(0.5, +Speed));
        float2 UV2 = frac(AuroraUV + float2(0.0, -Speed));
        float NoiseDiff = ShapeTex.SampleLevel(ShapeSampler, UV1, 0).r - ShapeTex.SampleLevel(ShapeSampler, UV2, 0).r;

        float ThinCurtain = pow((0.5 - abs(smoothstep(-Params.Smoothness, Params.Smoothness, NoiseDiff) - 0.5)) * 2.0, 2.0);
            
        return ThinCurtain * BaseParams.Density * MaskNoise * HeightFalloff * PathLenRatio;
    }

    float GetDensity_Spline(
        FSplineAuroraParams Params,
        float2 BaseUV,
        float NormalizedHeight,
        float HeightFalloff,
        float PathLenRatio,
        float TransmitFactor,
        float VoronoiVal,
        Texture2D ShapeTex, SamplerState ShapeSampler,
        Texture2D NoiseTex, SamplerState NoiseSampler,
        FAuroraBaseParams BaseParams
    )
    {
        // 1. Height Distortion Logic
        float DistHeight = pow(1.0 - NormalizedHeight, clamp(Params.DistortionHeightFalloff * VoronoiVal, 0.0, Params.DistortionHeightFalloff));
        
        // 2. UV Distortion Logic
        float2 DistUV1 = BaseUV * 3.0 + float2(1.0, 0.5) * BaseParams.AccumulatedTime * 0.02f;
        float2 DistUV2 = BaseUV * 3.0 + float2(-0.5, 1.0) * BaseParams.AccumulatedTime * 0.02f;
        float2 DistVec = lerp(NoiseTex.SampleLevel(NoiseSampler, DistUV1, 0).gb, NoiseTex.SampleLevel(NoiseSampler, DistUV2, 0).bg, 0.3);
        DistVec = (smoothstep(0.15, 1.0, DistVec) * 2.0 - 1.0) * Params.Distortion * TransmitFactor * DistHeight;
        
        float DFValue = ShapeTex.SampleLevel(ShapeSampler, BaseUV + DistVec, 0).r;
        
        // 3. Spline Shape Logic
        float PeakHeight = 0.3;
        float HeightDist = NormalizedHeight - PeakHeight;
        float SplineShape = pow(saturate(1.0 - HeightDist * lerp(-1.0 / PeakHeight, 1.0 / (1.0 - PeakHeight), step(0, HeightDist))), 1.8);
        
        float NoiseHeight = clamp(VoronoiVal * VoronoiVal, 0.0, 0.3);
        SplineShape = clamp(SplineShape - NoiseHeight * saturate(1.0 - abs(HeightDist) * 4.0) * 0.2, 0.0, 0.83);

        if (DFValue < Params.Thickness)
        {
            return BaseParams.Density * SplineShape * HeightFalloff * PathLenRatio * ((Params.Thickness - DFValue) * 0.002);
        }
        return 0.0;
    }
    
    float GetDensity_Flow(
        FFlowAuroraParams Params,
        float2 BaseUV,
        float NormalizedHeight,
        float HeightFalloff,
        float PathLenRatio,
        float TransmitFactor,
        float VoronoiVal,
        Texture2D ShapeTex, SamplerState ShapeSampler,
        Texture2D NoiseTex, SamplerState NoiseSampler,
        FAuroraBaseParams BaseParams
    )
    {
        float FlowDensity = ShapeTex.SampleLevel(ShapeSampler, BaseUV, 0).r;
        return FlowDensity * BaseParams.Density * HeightFalloff * PathLenRatio;
    }
    
    // ------------------------------------------------------------------------------
    // Macro Definition for Loop Generation (Type Specific)
    // ------------------------------------------------------------------------------

#define IMPLEMENT_RAYMARCH_VARIANT(FuncName, ParamType, DensityFunc) \
    FRayMarchResult FuncName( \
        ParamType Params, \
        Texture2D ShapeTex, SamplerState ShapeSampler, \
        Texture2D NoiseTex, SamplerState NoiseSampler \
    ) \
    { \
        float RayPathLen = max(BaseParams.ExitLen - BaseParams.EnterLen, 0.0f); \
        float StepLen = RayPathLen * rcp((float)AURORA_RAYMARCH_STEPS); \
        float BoxDiagLength = max(2.0f * length(BaseParams.BoxExtent), 1e-6f); \
        float PathLenRatio = RayPathLen / BoxDiagLength; \
        float TransmitFactor = lerp(0.15, 0.5, pow(abs(BaseParams.RayDir.z), 0.5)); \
        float DensityTotal = 1.0; \
        float3 ColorAccumulated = float3(0, 0, 0); \
        float CurrentLen = BaseParams.EnterLen; \
        [unroll] \
        for (int Iter = 0; Iter < AURORA_RAYMARCH_STEPS; Iter++) \
        { \
            CurrentLen = BaseParams.EnterLen + StepLen * (Iter + BaseParams.Jitter); \
            if (CurrentLen > BaseParams.ExitLen) break; \
            float3 RayPoint = BaseParams.RayOrigin + BaseParams.RayDir * CurrentLen; \
            float2 RayXYNorm = RayPoint.xy / BaseParams.BoxExtent.xy; \
            float2 BaseUV = RayXYNorm * 0.5 + 0.5; \
            float NormalizedHeight = (RayPoint.z + BaseParams.BoxExtent.z) / (2.0 * BaseParams.BoxExtent.z); \
            float GlobalHeightFalloff = pow(saturate(1.0 - NormalizedHeight), BaseParams.HeightFalloff); \
            float VoronoiVal = NoiseTex.SampleLevel(NoiseSampler, BaseUV * 0.2 + BaseParams.UnscaledTime * 0.005, 0).g; \
            float NoiseHeightShift = clamp(VoronoiVal * VoronoiVal, 0.0, BaseParams.ColorShiftStrength); \
            float EffectiveColorHeight = saturate(NormalizedHeight + 0.05 + abs(NoiseHeightShift)); \
            \
            float StepDensity = DensityFunc(Params, BaseUV, NormalizedHeight, GlobalHeightFalloff, PathLenRatio, TransmitFactor, VoronoiVal, ShapeTex, ShapeSampler, NoiseTex, NoiseSampler, BaseParams); \
            \
            StepDensity *= CalculateFade(RayPoint); \
            float3 FlowingRGB = CalculateColor(EffectiveColorHeight).rgb; \
            float StaticAlpha = CalculateColor(NormalizedHeight).a; \
            float3 StepRGB = FlowingRGB * StaticAlpha; \
            StepDensity *= StaticAlpha; \
            float StepTransmittance = clamp(1.0 - StepDensity, 0.0001, 1.0); \
            float OpticalDepth = 1.0 - StepTransmittance; \
            if (BaseParams.bEnableStructureColoring > 0.5) \
            { \
                float Structure = saturate(OpticalDepth / (BaseParams.EmissiveStructurePivot * 2.0)); \
                float3 StructureTint = lerp(BaseParams.SoftTint, BaseParams.CoreTint, Structure); \
                StepRGB *= StructureTint; \
            } \
            float EmissionWeight = 1.0; \
            if (BaseParams.bEnableEmissiveStructure > 0.5) \
            { \
                EmissionWeight = pow(saturate(OpticalDepth / BaseParams.EmissiveStructurePivot), BaseParams.EmissiveStructureSelectivity); \
            } \
            ColorAccumulated += StepRGB * OpticalDepth * EmissionWeight * DensityTotal; \
            DensityTotal *= StepTransmittance; \
            if (DensityTotal < 0.001) break; \
        } \
        FRayMarchResult Result; \
        Result.Density = (1.0 - DensityTotal) * 0.8; \
        Result.Color = ApplyToneShaping(ColorAccumulated); \
        return Result; \
    }
    
    // --- Generate the 3 Functions ---
    IMPLEMENT_RAYMARCH_VARIANT(ExecuteRayMarch_Noise, FNoiseAuroraParams, GetDensity_Noise)
    IMPLEMENT_RAYMARCH_VARIANT(ExecuteRayMarch_Spline, FSplineAuroraParams, GetDensity_Spline)
    IMPLEMENT_RAYMARCH_VARIANT(ExecuteRayMarch_Flow, FFlowAuroraParams, GetDensity_Flow)
};

#undef AURORA_RAYMARCH_STEPS