#pragma once
#include "../Private/AuroraNoise.ush"

#ifndef AURORA_RAYMARCH_STEPS
#define AURORA_RAYMARCH_STEPS 64
#endif

struct FNoiseParams
{
    float Density;
    
    float ShapeFrequency;
    float2 ShapeSpeed;
    
    bool bIsDual;
    float Smoothness;
    
    float MaskScaleMultiplier;
    float2 MaskSpeedMultiplier;
    float MaskOpacity;
    
    float Activity;
    
    bool bIsSpline;
    float Thickness;
    float Distortion;
    float DistortionSpeed;
    float DistortionHeightFalloff;
};

static const int RadialFadeType = 0;
static const int BoxFadeType = 1;

struct FFadeParams
{
    int FadeType; // 0 = RadialFade, 1 = BoxFade
    float FadeStartRatio;
    float HeightFalloff;
};

struct FRayMarchData
{
    float3 RayOrigin;
    float3 RayDir;
    float3 BoxExtent;
    float Time;
    float EnterLen;
    float ExitLen;
    float Jitter;
    
    FNoiseParams TargetNoise;

    FFadeParams FadeParams;
    
    float3 TopColor;
    float3 MidColor;
    float3 BottomColor;
    
    float bUseStructureColoring;
    float3 SoftTint;
    float3 CoreTint;
    
    float2 MidColorHeight; // mid start, end
    
    // Contrast Shaping = "Tone Remapping"
    // * 모든 누적이 끝난 뒤, 이미 만들어진 Color의 밝기 분포를 바꿈
    // * pivot을 기준으로 밝은 건 더 밝게, 어두운 건 더 어둡게 하니까
    // * 전체 톤 대비 변화가 존재하고, 톤 커브로 분위기/룩을 조정하는 역할 (색상 공간에서의 재매핑)

    float EmissiveTonePivot; // 톤 재분배의 기준 밝기
    float EmissiveContrast;
    float EmissiveSaturation;
    
    // ART LAYER = "Structure Selection"
    // * ray marching 중, 스텝 단위에서 이 스텝의 발광이 구조적으로 의미가 있어 더 누적될건지 판단
    // * 잡음성 발광이 제거되고 형태가 살아남아 띠가 또렷해짐 (쌓이는 과정 자체를 선택적으로 필터링) 
    
    float EmissiveStructurePivot; // 구조적으로 의미 있는 발광 기준
    float EmissiveStructureSelectivity; // 구조 강조 강도 (얼마나 남길지)
    float EmissiveStructureAmount; // 아트 레이어 최종 적용 정도
};

struct FRayMarchResult
{
    float Density;
    float3 Color;
};

struct FRayMarcher
{
    FRayMarchData RayMarchData;

    float2 UVTranslation(float2 BaseUV, float2 Speed, float Time)
    {
        return BaseUV + Speed * Time;
    }
    
    float CalculateFade(float3 RayPoint)
    {
        // 거리 계산 (타입에 따라)
        float DistanceFromCenter = 0.0;
    
        [branch]
        switch (RayMarchData.FadeParams.FadeType)
        {
            case BoxFadeType:
                DistanceFromCenter = max(abs(RayPoint.x), abs(RayPoint.y));
                break;
        
            case RadialFadeType:
            default:
                DistanceFromCenter = sqrt(RayPoint.x * RayPoint.x + RayPoint.y * RayPoint.y);
                break;
        }
    
        // 정규화 (최적화: 나눗셈 → 곱셈)
        float NormalizedDist = DistanceFromCenter / RayMarchData.BoxExtent.x;
        // TODO: 최적화: 나눗셈 → 곱셈
        // float NormalizedDist = DistanceFromCenter * RayMarchData.FadeParams.InvBoxExtentX;
    
        // Fade 계산
        float Fade = smoothstep(saturate(RayMarchData.FadeParams.FadeStartRatio), 1.0, NormalizedDist);
    
        return 1.0 - saturate(Fade);
    }

    float3 CalculateColor(float NormalizedHeight)
    {
        float H = saturate(NormalizedHeight);

        float MidStart = saturate(RayMarchData.MidColorHeight.x); // 0~1
        float MidEnd = saturate(RayMarchData.MidColorHeight.y); // 0~1
        MidEnd = max(MidEnd, MidStart + 0.0001);

        // Bottom to Mid
        float BlendBottomMid = saturate(H / MidStart);
        float3 Color = lerp(RayMarchData.BottomColor, RayMarchData.MidColor, BlendBottomMid);

        // Mid Range
        float MidMask = smoothstep(MidStart, MidEnd, H);

        // Mid to Top
        float BlendMidTop = saturate((H - MidEnd) / (1.0 - MidEnd));
        float3 TopBlend = lerp(RayMarchData.MidColor, RayMarchData.TopColor, BlendMidTop);

        Color = lerp(Color, TopBlend, MidMask);

        return Color;
    }
    
    float3 ApplyToneShaping(float3 Color, FRayMarchData Data)
    {
        // Contrast shaping (Non-linear pow-based)
        float Luminance = dot(Color, float3(0.299, 0.587, 0.114)); // calculate brightness of the color
        float Pivot = max(Data.EmissiveTonePivot, 1e-6);
        float k = Data.EmissiveContrast; // 1 = neutral

        float Normalized = Luminance / Pivot;
        Normalized = pow(Normalized, k);
        float AdjustedLum = Normalized * Pivot;

        float LumScale = (Luminance > 1e-6) ? (AdjustedLum / Luminance) : 0.0;
        Color *= LumScale;

        // Saturation shaping
        float3 Gray = Luminance.xxx;
        Color = lerp(Gray, Color, Data.EmissiveSaturation); // 0 = grayscale, 1 = original color
        
        return Color;
    }
    
    FRayMarchResult CurtainAndFlowAurora(
        Texture2D ShapeTex,
        SamplerState ShapeTexSampler,
        Texture2D SimplexNoiseTex,
        SamplerState SimplexNoiseSampler,
        float StepLen,
        float PathLenRatio)
    {
        float StepDensity = 0.0, DensityTotal = 1.0;
        float CurrentLen = RayMarchData.EnterLen;
        float3 ColorAccumulated = float3(0, 0, 0);
        
        [unroll]
        for (int Iter = 0; Iter < AURORA_RAYMARCH_STEPS; Iter++)
        {
            CurrentLen = RayMarchData.EnterLen + StepLen * (Iter + RayMarchData.Jitter);
            if (CurrentLen > RayMarchData.ExitLen)
            {
                break;
            }
            
            // 현재 레이마칭 Step 중인 점의 박스 로컬 좌표
            float3 RayPoint = RayMarchData.RayOrigin + RayMarchData.RayDir * CurrentLen;
            // 레이마칭 중인 점 로컬 좌표 정규화 (-1 ~ +1)
            float2 RayXYNorm = RayPoint.xy / RayMarchData.BoxExtent.xy;
        
            float NormalizedHeight = (RayPoint.z + RayMarchData.BoxExtent.z) / (2.0 * RayMarchData.BoxExtent.z);
            
            float HeightFactor = saturate(1.0 - NormalizedHeight);
            HeightFactor = pow(HeightFactor, RayMarchData.FadeParams.HeightFalloff);
            
            // 고도에 따른 색상 블렌딩
            float3 CurrentColor = CalculateColor(NormalizedHeight);
            
            // (-1 ~ +1) -> (0 ~ 1)
            float2 BaseUV = (RayXYNorm) * 0.5 + 0.5;
            
            [branch]
            if (RayMarchData.TargetNoise.bIsDual)
            {
                float2 AuroraUV = UVTranslation(BaseUV, RayMarchData.TargetNoise.ShapeSpeed, RayMarchData.Time);
                AuroraUV = AuroraUV * RayMarchData.TargetNoise.ShapeFrequency;
            
                // 마스크 UV 계산
                float2 MaskUV = UVTranslation(BaseUV, RayMarchData.TargetNoise.ShapeSpeed * RayMarchData.TargetNoise.MaskSpeedMultiplier, RayMarchData.Time);
                MaskUV = MaskUV * RayMarchData.TargetNoise.ShapeFrequency * RayMarchData.TargetNoise.MaskScaleMultiplier;
                MaskUV = frac(MaskUV);
                float MaskNoiseRaw = SimplexNoiseTex.SampleLevel(SimplexNoiseSampler, MaskUV, 0.0).g;

                // TODO: 추후 Smoothstep 역수로 최적화 필요?
                // 0.1 - 0.9 매직 넘버로 Smoothstep
                float MaskNoise = smoothstep(0.1, 0.9, MaskNoiseRaw);
                MaskNoise = lerp(1.0, MaskNoise, saturate(RayMarchData.TargetNoise.MaskOpacity));
                
                float Activity = RayMarchData.TargetNoise.Activity * RayMarchData.Time;
                float2 UV1 = AuroraUV + float2(0.5, +Activity);
                float2 UV2 = AuroraUV + float2(0.0, -Activity);
            
                UV1 = frac(UV1);
                UV2 = frac(UV2);
            
                float Noise1 = ShapeTex.SampleLevel(ShapeTexSampler, UV1, 0).r;
                float Noise2 = ShapeTex.SampleLevel(ShapeTexSampler, UV2, 0).r;
            
                float NoiseDiff = Noise1 - Noise2;
                float ThinCurtain = smoothstep(-RayMarchData.TargetNoise.Smoothness, RayMarchData.TargetNoise.Smoothness, NoiseDiff);
                ThinCurtain = (0.5 - abs(ThinCurtain - 0.5)) * 2.0;
                ThinCurtain = pow(ThinCurtain, 2.0);
            
                StepDensity = ThinCurtain * RayMarchData.TargetNoise.Density * MaskNoise * HeightFactor * PathLenRatio;
            }
            else
            {
                StepDensity = ShapeTex.SampleLevel(ShapeTexSampler, BaseUV, 0) * RayMarchData.TargetNoise.Density * HeightFactor * PathLenRatio;
            }
            
            StepDensity *= CalculateFade(RayPoint);
            
            float StepTransmittance = clamp(1.0 - StepDensity, 0.0001, 1.0);
            float OpticalDepth = 1.0 - StepTransmittance;
            
            // ART LAYER (structure-aware emissive weighting)
            float Normalized = saturate(OpticalDepth / RayMarchData.EmissiveStructurePivot);
            float k = RayMarchData.EmissiveStructureSelectivity;
            Normalized = pow(Normalized, k);
            float EmissionWeight = lerp(1.0, Normalized, RayMarchData.EmissiveStructureAmount);
            
            // COLOR SEPARATION
            float3 BaseColor = CalculateColor(NormalizedHeight); // Base palette

            // Color-only structure mask (gentle)
            float ColorStructure = saturate(OpticalDepth / (RayMarchData.EmissiveStructurePivot * 2.0));
            //ColorStructure = smoothstep(0.1, 0.6, ColorStructure);

            // Colors
            float3 SoftColor = BaseColor * RayMarchData.SoftTint;
            float3 CoreColor = BaseColor * RayMarchData.CoreTint;

            // Final step color
            float3 StepColor = lerp(SoftColor, CoreColor, ColorStructure);

            // Energy accumulation
            float3 FinalColor = lerp(CurrentColor, StepColor, saturate(RayMarchData.bUseStructureColoring));
            
            ColorAccumulated += FinalColor * OpticalDepth * EmissionWeight * DensityTotal;
            DensityTotal *= StepTransmittance;
        }
        
        FRayMarchResult Result;

        Result.Density = (1.0 - DensityTotal) * 0.8;
        Result.Color = ApplyToneShaping(ColorAccumulated, RayMarchData);
        
        return Result;
    }
    
    FRayMarchResult SplineAurora(
        Texture2D ShapeTex,
        SamplerState ShapeTexSampler,
        Texture2D SimplexNoiseTex,
        SamplerState SimplexNoiseSampler,
        float StepLen,
        float PathLenRatio)
    {
        float StepDensity = 0.0, DensityTotal = 1.0;
        float CurrentLen = RayMarchData.EnterLen;
        float3 ColorAccumulated = float3(0, 0, 0);
        
        float PeakHeight = 0.3;
        float InvPeak = 1.0 / PeakHeight;
        float InvRest = 1.0 / (1.0 - PeakHeight);
        
        [unroll]
        for (int Iter = 0; Iter < AURORA_RAYMARCH_STEPS; Iter++)
        {
            CurrentLen = RayMarchData.EnterLen + StepLen * (Iter + RayMarchData.Jitter);
            if (CurrentLen > RayMarchData.ExitLen)
            {
                break;
            }
        
            float3 RayPoint = RayMarchData.RayOrigin + RayMarchData.RayDir * CurrentLen;
            float2 RayXYNorm = RayPoint.xy / RayMarchData.BoxExtent.xy;
            float2 BaseUV = (RayXYNorm) * 0.5 + 0.5;
        
            float NormalizedHeight = (RayPoint.z + RayMarchData.BoxExtent.z) / (2.0 * RayMarchData.BoxExtent.z);
            
            float TransmitFactor = lerp(0.15, 0.5, pow(abs(RayMarchData.RayDir.z), 0.5));
            
            float VoronoiNoiseVal = SimplexNoiseTex.SampleLevel(SimplexNoiseSampler, BaseUV * 0.2 + RayMarchData.Time * 0.005, 0).g;
            float DistortionHeightNoise = clamp(RayMarchData.TargetNoise.DistortionHeightFalloff * VoronoiNoiseVal, 0.0, RayMarchData.TargetNoise.DistortionHeightFalloff);
            
            float DistortionHeight = pow(1.0 - NormalizedHeight, DistortionHeightNoise);
            
            float NoiseHeight = clamp(VoronoiNoiseVal * VoronoiNoiseVal, 0.0, 0.3);
            // 고도에 따른 색상 블렌딩
            float3 CurrentColor = CalculateColor(NormalizedHeight + 0.05 + abs(NoiseHeight));
            
            //float StepNoise = SimplexNoiseTex.SampleLevel(SimplexNoiseSampler, BaseUV * 0.1 + RayMarchData.Time * 0.001, 0).r * 2.0;
            //StepNoise *= StepNoise;
            {
                float2 UVTransformed = BaseUV + (1.0 * SineShake(BaseUV, RayMarchData.Time * 0.01));
                
                float2 DistortionUV1 = UVTransformed * 3.0 + float2(1.0, 0.5) * RayMarchData.Time * RayMarchData.TargetNoise.DistortionSpeed;
                float2 DistortionUV2 = UVTransformed * 3.0 + float2(-0.5, 1.0) * RayMarchData.Time * RayMarchData.TargetNoise.DistortionSpeed;
                //float2 DistortionUV1 = UVTransformed * float2(1.0, 2.7) + float2(1.0, 0.5) * RayMarchData.Time * RayMarchData.TargetNoise.DistortionSpeed;
                //float2 DistortionUV2 = UVTransformed * float2(1.5, 3.9) + float2(-0.5, 1.0) * RayMarchData.Time * RayMarchData.TargetNoise.DistortionSpeed;
                float2 Distortion1 = SimplexNoiseTex.SampleLevel(SimplexNoiseSampler, DistortionUV1, 0.0).gb;
                float2 Distortion2 = SimplexNoiseTex.SampleLevel(SimplexNoiseSampler, DistortionUV2, 0.0).bg;
                
                float2 Distortion = lerp(Distortion1, Distortion2, 0.3);
                Distortion = smoothstep(float2(1.0, 1.0) * 0.15, float2(1.0, 1.0) * 1.0, Distortion);
             
                Distortion = (Distortion * 2.0 - 1.0) * RayMarchData.TargetNoise.Distortion * TransmitFactor * DistortionHeight;
                
                float DFValue = ShapeTex.SampleLevel(ShapeTexSampler, UVTransformed + Distortion, 0);
                
                float HeightDist = NormalizedHeight - PeakHeight;
                float HeightFactor = saturate(1.0 - HeightDist * lerp(-InvPeak, InvRest, step(0, HeightDist)));
                HeightFactor = pow(HeightFactor, 1.8);
                
                float Sharpness = saturate(1.0 - abs(HeightDist) * 4.0) * 0.2;
                HeightFactor = clamp(HeightFactor - NoiseHeight * Sharpness, 0.0, 0.83);
                
                if (DFValue < RayMarchData.TargetNoise.Thickness)
                {
                    // 외각선으로부터 거리, 중심부가 더 밝게 조절하기 위함
                    float R = (RayMarchData.TargetNoise.Thickness - DFValue);
                    
                    StepDensity = RayMarchData.TargetNoise.Density * HeightFactor * PathLenRatio * (R * 0.002);
                }
                else
                {
                    StepDensity = 0;
                }
            }



            StepDensity *= CalculateFade(RayPoint);
            
            float StepTransmittance = clamp(1.0 - StepDensity, 0.0001, 1.0);

            ColorAccumulated += CurrentColor * (1.0 - StepTransmittance) * DensityTotal;
            DensityTotal *= StepTransmittance;
            
        }

        FRayMarchResult Result;
        
        Result.Density = (1.0 - DensityTotal) * 0.8;
        Result.Color = ApplyToneShaping(ColorAccumulated, RayMarchData);
        
        return Result;
    }
     
    
    FRayMarchResult RayMarch(
        FRayMarchData InRayMarchData,
        Texture2D ShapeTex,
        SamplerState ShapeTexSampler,
        Texture2D SimplexNoiseTex,
        SamplerState SimplexNoiseSampler)
    {
        //float Jitter = frac(sin(dot(RayMarchData.RayDir.xy * 10000.0, float2(12.9898, 78.233))) * 43758.5453);
        RayMarchData = InRayMarchData;
        
        // 긴 곳은 더 많이 곱하기 위해서
        float BoxDiagLength = max(2.0f * length(RayMarchData.BoxExtent), 1e-6f);
        float RayPathLen = max(RayMarchData.ExitLen - RayMarchData.EnterLen, 0.0f);
        float StepLen = RayPathLen * rcp((float) AURORA_RAYMARCH_STEPS);
        float PathLenRatio = RayPathLen / BoxDiagLength;

        [branch]
        if (RayMarchData.TargetNoise.bIsSpline)
        {
            return SplineAurora(ShapeTex, ShapeTexSampler, SimplexNoiseTex, SimplexNoiseSampler, StepLen, PathLenRatio);
        }
        else
        {
            return CurtainAndFlowAurora(ShapeTex, ShapeTexSampler, SimplexNoiseTex, SimplexNoiseSampler, StepLen, PathLenRatio);
        }
    }
};

#undef AURORA_RAYMARCH_STEPS
